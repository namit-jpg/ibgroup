{
  "name": "whatsapp-slack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Two-way WhatsApp inbox: Sendvise webhooks into Slack, thread replies back to WhatsApp.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
