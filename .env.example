PORT=3000
# Public https origin of this server, no trailing slash.
# Example: https://wa.example.com  or  https://abc123.ngrok-free.app
PUBLIC_BASE_URL=

# Sendvise → Dashboard → Settings → API Keys. Starts with sv_live_.
SENDVISE_API_KEY=
# Shown once when you save the webhook in Dashboard → Settings → Webhook Integrations.
SENDVISE_WEBHOOK_SECRET=
SENDVISE_BASE_URL=https://app.sendvise.com/api
# Optional. Set only if the Sendvise account has more than one WhatsApp number.
SENDVISE_PHONE_NUMBER_ID=
SENDVISE_TEMPLATE_LANGUAGE=en

# Slack → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=
# Slack → OAuth & Permissions → Bot User OAuth Token (xoxb-)
SLACK_BOT_TOKEN=
# Slack → Basic Information → App-Level Tokens → connections:write (xapp-)
SLACK_APP_TOKEN=

# People who can be handed an inbound WhatsApp chat, in rotation.
# Slack profile → ⋯ → Copy member ID. Comma-separated.
SLACK_AGENT_USER_IDS=
# Private channels keep the phone number off the public channel list.
SLACK_PRIVATE_CHANNELS=true

DATA_PATH=./data/bridge.sqlite
